model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["portfolioholding","company","sector","portfolio","investor"]

ref table portfolioholding
ref table company
ref table sector
ref table portfolio
ref table investor

ref cultureInfo en-IN

