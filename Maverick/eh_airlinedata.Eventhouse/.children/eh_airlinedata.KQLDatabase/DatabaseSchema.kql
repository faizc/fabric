// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table aircraft (aircraft_id:string, timestamp_utc:datetime, fuel_rem_kg:real, engine_vib_rms:real, hyd_press_psi:real) 
.create-merge table aircraft_maintenance_events (mnt_evt_id:string, timestamp_utc:datetime, diag_score:real) 
.create-merge table airports (ap_id:string, timestamp_utc:datetime, avg_sec_wait_min:real, avg_taxi_out_min:real) 
.create-merge table baggage (bag_id:string, timestamp_utc:datetime, bag_temp_c:real, shock_g:real) 
.create-merge table crew_assignments (crew_asgn_id:string, timestamp_utc:datetime, fatigue_score:real) 
.create-merge table flights (flt_id:string, timestamp_utc:datetime, alt_ft:real, gnd_spd_kts:real, delay_min:long) 
.create-merge table gates (gate_id:string, timestamp_utc:datetime, brd_q_len:long) 
.create-merge table runways (rwy_id:string, timestamp_utc:datetime, surf_temp_c:real, brake_action_index:real, wind_gust_kts:real) 
